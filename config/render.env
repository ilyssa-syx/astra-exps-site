# Site-owned runtime defaults for offline iteration video rendering.
# Every value can be overridden by exporting it before scripts/run_egl.sh.

ASTRA_SITE_PYTHON="${ASTRA_SITE_PYTHON:-/home/yixuansu/miniforge3/envs/sam3d-objects/bin/python3.11}"
ASTRA_SITE_EXTERNAL_ROOT="${ASTRA_SITE_EXTERNAL_ROOT:-/grogu/datasets/yixuansu/models/iclr-table/hoi-from-rgb-d}"

export PYOPENGL_PLATFORM="${PYOPENGL_PLATFORM:-egl}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-8}"

